{
  "version": 2,
  "buildCommand": "prisma generate",
  "installCommand": "npm install",
  "outputDirectory": "",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/daily",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/internal/cron/weekly-monday",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/internal/cron/monthly",
      "schedule": "0 3 1 * *"
    }
  ]
}
