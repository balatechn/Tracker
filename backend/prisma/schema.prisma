generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entry {
  id              Int          @id @default(autoincrement())
  srNo            Int?
  serviceName     String
  category        String?
  billingCompany  String?
  vendor          String?
  expiryDate      DateTime?
  autoRenewal     Boolean      @default(false)
  owner           String?
  criticality     String?
  lastRenewalDate DateTime?
  renewalPeriod   Int?
  annualCost      Float?
  paymentMethod   String?
  invoiceRef      String?
  financeEmail    String?
  adminEmail      String?
  vendorEmail     String?
  remarks         String?
  // Physical asset fields
  assetTag        String?
  serialNumber    String?
  location        String?
  condition       String?      @default("Good")
  assetStatus     String?      @default("Available")
  purchaseDate    DateTime?
  purchasePrice   Float?
  warrantyYears   Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  allocations     Allocation[]
}

model Employee {
  id            Int          @id @default(autoincrement())
  empId         String       @unique
  name          String
  email         String       @unique
  department    String
  designation   String?
  phone         String?
  manager       String?
  status        String       @default("Active")
  joiningDate   DateTime?
  exitDate      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  allocations   Allocation[]
}

model Allocation {
  id           Int       @id @default(autoincrement())
  assetId      Int
  asset        Entry     @relation(fields: [assetId], references: [id])
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id])
  allocatedAt  DateTime  @default(now())
  returnedAt   DateTime?
  status       String    @default("Active")
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AssetRequest {
  id            Int      @id @default(autoincrement())
  requestType   String
  requestedBy   String
  assetId       Int?
  description   String
  status        String   @default("Pending")
  approvalStage String   @default("Manager")
  approvedBy    String?
  rejectedBy    String?
  comments      String?
  priority      String?  @default("Medium")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int
  entityName String?
  userId     String   @default("admin")
  details    String?
  createdAt  DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Task {
  id              Int              @id @default(autoincrement())
  taskName        String
  projectName     String?
  location        String?
  department      String?
  description     String?
  assignedTo      String?
  startDate       DateTime
  endDate         DateTime
  priority        String           @default("Medium")
  status          String           @default("Planned")
  dependencyIds   String?
  estimatedHours  Float?
  actualHours     Float?
  notes           String?
  completionPct   Int              @default(0)
  milestone       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  comments        TaskComment[]
  attachments     TaskAttachment[]
  activities      TaskActivity[]
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    String   @default("admin")
  content   String
  createdAt DateTime @default(now())
}

model TaskAttachment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename  String
  filesize  Int?
  mimetype  String?
  data      Bytes?
  createdAt DateTime @default(now())
}

model Subscription {
  id              Int       @id @default(autoincrement())
  srNo            Int?
  name            String
  type            String    @default("SAAS")
  billingCompany  String?
  registrar       String?
  expiryDate      DateTime?
  autoRenewal     Boolean   @default(false)
  owner           String?
  criticality     String?   @default("High")
  lastRenewalDate DateTime?
  renewalPeriod   Int?
  annualCost      Float?
  paymentMethod   String?
  invoiceRef      String?
  financeEmail    String?
  adminEmail      String?
  vendorEmail     String?
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TaskActivity {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdBy String   @default("admin")
  createdAt DateTime @default(now())
}
